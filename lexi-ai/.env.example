# Environment Variables Template for LEXI AI
# Copy this file to .env and fill in your free-tier API keys.
# At minimum, set ONE of: GROQ_API_KEY or GEMINI_API_KEY

# ─── Free Tier API Keys ──────────────────────────────────────
# Groq: https://console.groq.com (free, ~30 RPM)
GROQ_API_KEY=

# Google Gemini: https://aistudio.google.com/apikey (free, 15 RPM, 1M TPM)
GEMINI_API_KEY=

# OpenRouter: https://openrouter.ai/keys (free models available)
OPENROUTER_API_KEY=

# HuggingFace: https://huggingface.co/settings/tokens (free serverless inference)
HF_TOKEN=

# ─── Optional Configuration ──────────────────────────────────
# Local model server URL (e.g., Ollama, vLLM, LM Studio)
LEXI_LOCAL_URL=

# Custom system prompt override
LEXI_SYSTEM_PROMPT=

# Server port
PORT=7860
