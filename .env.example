# SkillLink Vercel Production Environment Variables

# App Domain
NEXT_PUBLIC_APP_URL=https://skilllink.vercel.app

# Supabase Auth & Storage Config
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# LEXI AI Engine Keys (Google Gemini 1.5 Flash / OpenAI gpt-4o-mini)
GEMINI_API_KEY=your_google_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
NEXT_PUBLIC_LEXI_API_KEY=your_lexi_api_key
